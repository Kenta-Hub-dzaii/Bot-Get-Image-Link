# ==================== DISCORD BOT CONFIG ====================
DISCORD_TOKEN=your_bot_token_here

# ==================== BOT MODE SETTINGS ====================
# Chế độ bot: whitelist (chỉ user trong whitelist được dùng) hoặc blacklist (chặn user trong blacklist)
BOT_MODE=whitelist
# Giới hạn dung lượng hàng ngày cho mỗi user (MB)
DAILY_LIMIT_MB=100

# ==================== API KEYS ====================
# ImgBB API Key - Lấy từ https://api.imgbb.com/
IMGUR_CLIENT_ID=your_imgbb_api_key_here

# ==================== CHANNEL IDs ====================
# Kênh để gửi log vi phạm
VIOLATION_LOG_CHANNEL_ID=123456789012345678

# Kênh để nhận report bug
REPORT_CHANNEL_ID=123456789012345678

# Kênh để backup ảnh (có thể nhiều kênh, phân cách bằng dấu phẩy)
BACKUP_CHANNEL_IDS=123456789012345678,987654321098765432

# ==================== ADMIN SETTINGS ====================
# ID của admin (có thể nhiều user, phân cách bằng dấu phẩy)
ADMIN_USER_IDS=123456789012345678,987654321098765432

# ==================== BOT BEHAVIOR SETTINGS ====================
# Thời gian tự động xóa tin nhắn (giây)
AUTO_DELETE_TIME=300
# Số ảnh tối đa mỗi lần upload
MAX_IMAGES=10
# Định dạng ảnh được phép (phân cách bằng dấu phẩy)
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,bmp
# Kích thước file tối đa (MB)
MAX_FILE_SIZE_MB=32
# Thời gian chờ giữa các lệnh (giây)
COOLDOWN_TIME=30
# Tự động backup ảnh (true/false)
AUTO_BACKUP=true
# Ngôn ngữ bot (vi/en)
LANGUAGE=vi
# Chế độ premium (true/false)
PREMIUM_MODE=false

# ==================== TCOIN SYSTEM ====================
# URL website để nhận Tcoin (vượt link)
TCOIN_WEB_URL=https://your-tcoin-website.com

# ==================== ADVANCED SETTINGS ====================
# Thời gian timeout cho các lệnh (giây)
UPLOAD_TIMEOUT=3600
CONVERT_TIMEOUT=300
LINK_TIMEOUT=10
# Giới hạn Tcoin hàng ngày
MAX_UPLOAD_PER_DAY=10
MAX_LINK_PER_DAY=5
# Giá Premium (Tcoin)
PREMIUM_PRICE=500
PREMIUM_DAYS=3
